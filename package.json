{
  "name": "richmack-the-forest",
  "version": "2.2.2",
  "private": true,
  "description": "Richmack: The Forest is an optimized browser-based haunted open-world driving survival game built with Three.js.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:syntax": "find js tests -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test:all": "npm run test:syntax && npm test",
    "serve": "python3 -m http.server 8000"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module"
}
