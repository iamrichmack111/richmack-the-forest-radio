{
  "name": "richmack-the-forest",
  "version": "2.2.3",
  "private": true,
  "description": "Richmack: The Forest is an optimized browser-based haunted open-world driving survival game built with Three.js.",
  "scripts": {
    "test": "playwright test",
    "test:syntax": "find js tests -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test:all": "npm run test:syntax && npm test",
    "serve": "python3 -m http.server 8000",
    "test:e2e": "playwright test",
    "screenshots": "playwright test tests/screenshots.spec.js",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
